section#work
    .container
        .row
            .col-sm-12
                h2.section-title Work

        .row.work-grid#workGrid
            //- Work Item 1
            .col-sm-12.col-md-6.col-lg-3.work-item(data-work="1")
                .work-card
                    .work-card-image
                        img(src="https://via.placeholder.com/400x400" alt="Project 1")
                    .work-card-title Project Title 1
                .work-details
                    .work-details-content
                        .work-details-header
                            h3 Project Title 1
                            button.close-btn ×
                        .work-details-body
                            .work-details-image
                                img(src="https://via.placeholder.com/800x600" alt="Project 1 Detail")
                            .work-details-text
                                p.work-description This is a detailed description of Project 1. Here you can explain the concept, your role, technologies used, and the outcome of the project.
                                .work-meta
                                    .work-meta-item
                                        strong Client:
                                        span  Client Name
                                    .work-meta-item
                                        strong Year:
                                        span  2024
                                    .work-meta-item
                                        strong Role:
                                        span  Design & Development

